---
import { ClientRouter } from "astro:transitions";

const {
  title = "Our Story",
  description = "A handwritten memorial site built with Astro.",
  /*
   * ============================================================
   *  🔧 OG 开放图谱参数 — 按需替换以下默认值
   * ============================================================
   */
  // 1️⃣ og:image — 替换为你的 OG 预览图完整 URL（推荐 1200×630 px, <300KB）
  ogImage = "https://story.lxrme.com/assets/og-image.jpg",
  // 2️⃣ og:type — 首页用 "website"，文章/详情页用 "article"
  ogType = "website",
} = Astro.props;

/*
 * 自动拼接当前页面的完整 URL。
 * 域名来自 astro.config.mjs 中的 site 字段，无需手动替换。
 */
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link
      rel="preload"
      href="/fonts/Laura%20Cursive.otf"
      as="font"
      type="font/otf"
      crossorigin
    />
    <title>{title}</title>

    <!--
    ============================================================
     Open Graph / 开放图谱  &  微信分享预览卡片
    ============================================================
    微信抓取优先级：og:title > title > 页面正文推断
                    og:description > meta description > 正文前几段
                    og:image  > 页面内第一张大图（≥300×300px）
    ============================================================
    -->
    <!-- ✅ og:title — 分享卡片标题（16-20 字最佳，勿超过 30 字） -->
    <meta property="og:title" content={title} />
    <!-- ✅ og:description — 分享卡片描述（30-50 字最佳） -->
    <meta property="og:description" content={description} />
    <!-- ✅ og:image — 分享卡片图片，替换上面的 ogImage 变量 -->
    <meta property="og:image" content={ogImage} />
    <!-- ✅ og:image:width / og:image:height — 帮助微信快速解析 -->
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- ✅ og:url — 当前页面完整地址 -->
    <meta property="og:url" content={canonicalUrl} />
    <!-- ✅ og:type — 页面类型 -->
    <meta property="og:type" content={ogType} />
    <!-- ✅ og:site_name — 站点名称 -->
    <meta property="og:site_name" content="Our Story" />
    <!-- ✅ og:locale — 语言区域（中文） -->
    <meta property="og:locale" content="zh_CN" />

    <!-- Twitter Card（微信在部分场景也会参考） -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!--
    ============================================================
     微信 JS-SDK 兼容（可选，进一步优化微信内分享体验）
     如需使用，请先开通微信公众号并配置 JS 安全域名。
     不开通也不影响 OG 标签的抓取效果。
    ============================================================
    -->
    <!-- 微信网页授权：itemprop 系列，微信爬虫会读取作为备用 -->
    <meta itemprop="name" content={title} />
    <meta itemprop="description" content={description} />
    <meta itemprop="image" content={ogImage} />

    <ClientRouter fallback="animate" />
    <script is:inline>
      // 首次加载时立即在 <html> 上标记骨架屏状态，避免字体就绪前露出文字
      if (!window.__pgFontsReady) {
        document.documentElement.classList.add("fonts-loading");

        const MAX_WAIT_MS = 6000;

        const finish = () => {
          if (window.__pgFontsReady) return;
          window.__pgFontsReady = true;
          const html = document.documentElement;
          html.classList.remove("fonts-loading");
          html.classList.add("fonts-loaded");
        };

        const timer = setTimeout(finish, MAX_WAIT_MS);

        // 骨架屏把文字设为透明，浏览器会认为没有可见字形需要该字体，
        // 于是根本不去下载它，document.fonts.ready 立刻 resolve → 骨架屏提前移除、
        // 露出回退字体，随后 web 字体才加载并替换，造成字体闪烁。
        // 这里显式触发字体下载，并等待「该字体」真正就绪。
        const fontsReady =
          document.fonts && typeof document.fonts.load === "function"
            ? document.fonts
                .load('1em "Laura Cursive"')
                .catch(() => {})
                .then(() => document.fonts.ready)
            : Promise.resolve();

        fontsReady.then(() => {
          clearTimeout(timer);
          // 双 rAF：确保浏览器已用新字体完成首帧绘制，再移除骨架屏
          requestAnimationFrame(() => requestAnimationFrame(finish));
        });
      }
    </script>
  </head>
  <body>
    <slot />
    <script>
      if (!window.__ourStoryTransitionImagesReady) {
        window.__ourStoryTransitionImagesReady = true;

        const preloadImage = (src, signal) =>
          new Promise((resolve) => {
            if (!src || signal?.aborted) {
              resolve();
              return;
            }

            const image = new Image();
            const finish = () => resolve();

            image.onload = async () => {
              try {
                await image.decode?.();
              } catch {
                // Decoding is a polish step; failed decode should never block navigation.
              }
              finish();
            };
            image.onerror = finish;
            image.src = src;
          });

        const warmNextPageImages = async (event) => {
          const nextDocument = event.newDocument;
          const nextUrl = event.to;

          if (!(nextDocument instanceof Document) || !(nextUrl instanceof URL)) {
            return;
          }

          const images = Array.from(
            nextDocument.querySelectorAll(
              ".hero-photo img, .photo-tile img, .small-photo img, .generated-couple, .generated-flower, .bottom-park-art",
            ),
          )
            .map((image) => image.getAttribute("src"))
            .filter(Boolean)
            .slice(0, 8)
            .map((src) => new URL(src, nextUrl).href);

          if (!images.length) {
            return;
          }

          await Promise.race([
            Promise.allSettled(images.map((src) => preloadImage(src, event.signal))),
            new Promise((resolve) => setTimeout(resolve, 850)),
          ]);
        };

        document.addEventListener("astro:before-preparation", (event) => {
          const originalLoader = event.loader;

          if (typeof originalLoader !== "function") {
            return;
          }

          event.loader = async () => {
            await originalLoader();

            if (!event.defaultPrevented && !event.signal?.aborted) {
              await warmNextPageImages(event);
            }
          };
        });
      }
    </script>
  </body>
</html>
